# 观澜投研 · StockLens  AI 问答配置
# 复制本文件为 .env 并填写密钥（.env 已被 .gitignore 忽略，不会被提交）
# 复制命令（PowerShell）：Copy-Item .env.example .env

# DeepSeek 示例（OpenAI 兼容，开箱即用）
AI_API_KEY=sk-在这里粘贴你的密钥
AI_BASE_URL=https://api.deepseek.com
AI_MODEL=deepseek-chat

# 消息面抓取：默认使用同花顺“重要”快讯；设为 local 可改用 data/news.json
NEWS_PROVIDER=10jqka
# 自定义标准 JSON API 时填写 URL，并将 NEWS_PROVIDER 改为 custom
NEWS_API_URL=
NEWS_API_KEY=

# 其它 OpenAI 兼容平台也可用，例如：
#   OpenAI   AI_BASE_URL=https://api.openai.com/v1                        AI_MODEL=gpt-4o-mini
#   Kimi     AI_BASE_URL=https://api.moonshot.cn                           AI_MODEL=moonshot-v1-8k
#   智谱     AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4              AI_MODEL=glm-4-flash
#   通义     AI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  AI_MODEL=qwen-plus
